{
  "$schema": "http://json.schemastore.org/jsonc",
  "blocks": [
    {
      "id": "product-details",
      "type": "product-details",
      "props": {
        "name": "Product Name",
        "price": 100,
        "addToCart": {
          "type": "function"
        }
      }
    },
    {
      "id": "add-to-cart-button",
      "type": "add-to-cart-button",
      "props": {
        "onClick": {
          "type": "function"
        }
      }
    }
  ]
}